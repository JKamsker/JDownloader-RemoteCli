<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>jdr</AssemblyName>
    <RootNamespace>JDownloader.Cli</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jdr</ToolCommandName>
    <PackageId>JDownloader-RemoteCli</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>JKamsker</Authors>
    <Description>Remote CLI for JDownloader (My.JDownloader).</Description>
    <PackageTags>jdownloader;myjdownloader;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/JKamsker/JDownloader-RemoteCli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JKamsker/JDownloader-RemoteCli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\\..\\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
