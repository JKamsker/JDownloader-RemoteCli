#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

mapfile -t staged_cs_files < <(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')

run_dotnet_format() {
  local project="$1"
  shift
  local files=("$@")

  if [[ "${#files[@]}" -eq 0 ]]; then
    return
  fi

  dotnet format whitespace "$project" --verbosity minimal --no-restore --include "${files[@]}"
  dotnet format style "$project" --verbosity minimal --no-restore --include "${files[@]}"
}

if command -v dotnet >/dev/null 2>&1; then
  dotnet_version="$(dotnet --version 2>/dev/null || true)"
  dotnet_major="${dotnet_version%%.*}"

  if [[ "$dotnet_major" =~ ^[0-9]+$ ]] && [[ "$dotnet_major" -ge 10 ]]; then
    if [[ "${#staged_cs_files[@]}" -gt 0 ]]; then
      echo "Running dotnet format on staged C# files (pre-commit)..."

      dotnet restore --verbosity minimal >/dev/null

      if command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/format-oneline-csharp.ps1" -Paths "${staged_cs_files[@]}"
      else
        echo "pwsh not found; skipping scripts/format-oneline-csharp.ps1." >&2
      fi

      cli_cs_files=()
      test_cs_files=()
      for file in "${staged_cs_files[@]}"; do
        case "$file" in
          src/JDownloader.Cli/*) cli_cs_files+=("$file") ;;
          src/JDownloader.Cli.Tests/*) test_cs_files+=("$file") ;;
        esac
      done

      run_dotnet_format "src/JDownloader.Cli/JDownloader.Cli.csproj" "${cli_cs_files[@]}"
      run_dotnet_format "src/JDownloader.Cli.Tests/JDownloader.Cli.Tests.csproj" "${test_cs_files[@]}"

      git add -- "${staged_cs_files[@]}"
    fi
  else
    echo "dotnet SDK >= 10 not found (detected '${dotnet_version:-unknown}'); skipping dotnet format." >&2
  fi
else
  echo "dotnet not found; skipping dotnet format." >&2
fi

loc_limit_max=500
loc_limit_soft=300
exclude_file=".githooks/loc-limit-exclude.txt"

matches_exclusion() {
  local file="$1"

  if [[ ! -f "$exclude_file" ]]; then
    return 1
  fi

  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" ]] && continue
    [[ "$pattern" =~ ^[[:space:]]*# ]] && continue

    # trim whitespace
    pattern="${pattern#"${pattern%%[![:space:]]*}"}"
    pattern="${pattern%"${pattern##*[![:space:]]}"}"
    [[ -z "$pattern" ]] && continue

    if [[ "$file" == $pattern ]]; then
      return 0
    fi
  done < "$exclude_file"

  return 1
}

is_autogenerated() {
  local file="$1"

  case "$file" in
    */obj/*|*/bin/*) return 0 ;;
    *.g.cs|*.designer.cs|*.generated.cs|*.AssemblyInfo.cs) return 0 ;;
  esac

  return 1
}

is_code_file() {
  local file="$1"

  case "$file" in
    *.cs|*.ps1|*.psm1|*.sh) return 0 ;;
  esac

  return 1
}

failed=0

while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  if ! is_code_file "$file"; then
    continue
  fi

  if is_autogenerated "$file"; then
    continue
  fi

  if matches_exclusion "$file"; then
    continue
  fi

  if ! git cat-file -e ":$file" 2>/dev/null; then
    continue
  fi

  # count staged lines (not working tree)
  lines="$(git show ":$file" | wc -l | tr -d '[:space:]')"
  if [[ "$lines" -gt "$loc_limit_max" ]]; then
    echo "ERROR: $file is $lines lines (max $loc_limit_max). Split the file or add an exclusion in $exclude_file." >&2
    failed=1
  elif [[ "$lines" -gt "$loc_limit_soft" ]]; then
    echo "Warning: $file is $lines lines (recommended <= $loc_limit_soft)." >&2
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
