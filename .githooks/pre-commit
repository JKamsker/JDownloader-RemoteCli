#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"

if command -v dotnet >/dev/null 2>&1; then
  echo "Running dotnet format (pre-commit)..."

  dotnet tool restore >/dev/null

  if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/format-oneline-csharp.ps1"
  fi

  dotnet format whitespace "src/JDownloader.Cli/JDownloader.Cli.csproj" --verbosity minimal
  dotnet format style "src/JDownloader.Cli/JDownloader.Cli.csproj" --verbosity minimal
  dotnet format whitespace "src/JDownloader.Cli.Tests/JDownloader.Cli.Tests.csproj" --verbosity minimal
  dotnet format style "src/JDownloader.Cli.Tests/JDownloader.Cli.Tests.csproj" --verbosity minimal

  git add -u
else
  echo "dotnet not found; skipping dotnet format." >&2
fi

loc_limit_max=500
loc_limit_soft=300
exclude_file=".githooks/loc-limit-exclude.txt"

matches_exclusion() {
  local file="$1"

  if [[ ! -f "$exclude_file" ]]; then
    return 1
  fi

  while IFS= read -r pattern || [[ -n "$pattern" ]]; do
    [[ -z "$pattern" ]] && continue
    [[ "$pattern" =~ ^[[:space:]]*# ]] && continue

    # trim whitespace
    pattern="${pattern#"${pattern%%[![:space:]]*}"}"
    pattern="${pattern%"${pattern##*[![:space:]]}"}"
    [[ -z "$pattern" ]] && continue

    if [[ "$file" == $pattern ]]; then
      return 0
    fi
  done < "$exclude_file"

  return 1
}

is_autogenerated() {
  local file="$1"

  case "$file" in
    */obj/*|*/bin/*) return 0 ;;
    *.g.cs|*.designer.cs|*.generated.cs|*.AssemblyInfo.cs) return 0 ;;
  esac

  return 1
}

is_code_file() {
  local file="$1"

  case "$file" in
    *.cs|*.ps1|*.psm1|*.sh) return 0 ;;
  esac

  return 1
}

failed=0

while IFS= read -r file; do
  [[ -z "$file" ]] && continue

  if ! is_code_file "$file"; then
    continue
  fi

  if is_autogenerated "$file"; then
    continue
  fi

  if matches_exclusion "$file"; then
    continue
  fi

  if ! git cat-file -e ":$file" 2>/dev/null; then
    continue
  fi

  # count staged lines (not working tree)
  lines="$(git show ":$file" | wc -l | tr -d '[:space:]')"
  if [[ "$lines" -gt "$loc_limit_max" ]]; then
    echo "ERROR: $file is $lines lines (max $loc_limit_max). Split the file or add an exclusion in $exclude_file." >&2
    failed=1
  elif [[ "$lines" -gt "$loc_limit_soft" ]]; then
    echo "Warning: $file is $lines lines (recommended <= $loc_limit_soft)." >&2
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ "$failed" -ne 0 ]]; then
  exit 1
fi
